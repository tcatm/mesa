# Elysium (provider-agnostic: any RPC that serves the chain works)
ELYSIUM_RPC_URL=
ELYSIUM_TESTNET_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz

# Deploy (see contracts/script/Deploy.s.sol)
EXPECTED_CHAIN_ID=99801
# The official Uniswap v4 PoolManager. Verify on the explorer before use.
POOL_MANAGER=
# Rehearsal only: deploy a PoolManager instead (testnet and local chains).
DEPLOY_POOL_MANAGER=false
MESA_GENESIS_LAUNCHER=
MESA_OWNER=
MESA_KEEPER=
# Governs ERC-20 quote assets (3-day delay to add, instant to disable). 0x0000000000000000000000000000000000000000 = HYPE only, for good.
MESA_QUOTE_ADMIN=
CREATOR_SHARE_BPS=7000
INITIAL_TICK=173200
BUYBACK_MAX_PER_CALL=10000000000000000000
