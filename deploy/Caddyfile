# node.mesa.cx: the raw Elysium node and the server's status pages, only
# under the secret path. rpc.mesa.cx: the relay, for wallets.
# api.mesa.cx: the terminal API. status.mesa.cx: public health and uptime.
node.mesa.cx {
	handle_path /{$NODE_SECRET_PATH}/status/* {
		root * /srv/status
		file_server browse
	}
	handle_path /{$NODE_SECRET_PATH}/* {
		reverse_proxy 127.0.0.1:8547
	}
	respond "Mesa" 200
}

rpc.mesa.cx {
	reverse_proxy 127.0.0.1:8545
}

api.mesa.cx {
	# Other chains' market data (Codex, via the market service).
	handle /hyperevm/* {
		reverse_proxy 127.0.0.1:8085
	}
	# Relay for the bridge's any-chain deposits, with Mesa's key added server-side.
	handle /relay/* {
		request_body {
			max_size 32KB
		}
		reverse_proxy 127.0.0.1:8085
	}
	# Token images, checked and cached, so the site loads images from here only.
	handle /img {
		reverse_proxy 127.0.0.1:8085
	}
	# Images uploaded on the launch page, and where they are served from.
	handle /upload {
		request_body {
			max_size 4MB
		}
		reverse_proxy 127.0.0.1:8085
	}
	handle /media/* {
		reverse_proxy 127.0.0.1:8085
	}
	# The Elysium mainnet terminal (every launchpad), from our own node.
	handle_path /elysium/* {
		reverse_proxy 127.0.0.1:8081 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8080 {
			flush_interval -1
		}
	}
}

status.mesa.cx {
	reverse_proxy 127.0.0.1:8090
}
