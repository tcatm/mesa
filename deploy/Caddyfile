# node.mesa.cx: the raw Elysium node and the server's status pages, only
# under the secret path. rpc.mesa.cx: the relay, for wallets.
# api.mesa.cx: the terminal API.
node.mesa.cx {
	handle_path /{$NODE_SECRET_PATH}/status/* {
		root * /srv/status
		file_server browse
	}
	handle_path /{$NODE_SECRET_PATH}/* {
		reverse_proxy 127.0.0.1:8547
	}
	respond "Mesa" 200
}

rpc.mesa.cx {
	reverse_proxy 127.0.0.1:8545
}

api.mesa.cx {
	reverse_proxy 127.0.0.1:8080 {
		flush_interval -1
	}
}
